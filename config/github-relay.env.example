# Public-safe example only. Keep the real file mode 0600 and never commit keys.
SENTINEL_URL=https://sentinel-gateway.example
SENTINEL_CA_FILE=/etc/tethys-sentinel/gateway-public-ca.crt

SENTINEL_GITHUB_APP_ID=123456
SENTINEL_GITHUB_INSTALLATION_ID=987654
SENTINEL_GITHUB_APP_PRIVATE_KEY_FILE=/etc/tethys-sentinel/github-relay-app.pem

SENTINEL_GITHUB_RELAY_STATE_DIR=/var/lib/tethys-sentinel-github-relay
SENTINEL_GITHUB_POLL_INTERVAL=5s