# Exact browser origin. It must match the URL operators use, including port.
# The server certificate must contain the corresponding DNS name or IP SAN.
SENTINEL_OPERATOR_PUBLIC_ORIGIN=https://sentinel-operator.example:8444

# Bind only the intended management address. Do not expose a plain HTTP listener.
SENTINEL_OPERATOR_LISTEN=192.0.2.10:8444

# Control is intentionally loopback-only; sentinel-operator rejects non-loopback Control URLs.
SENTINEL_OPERATOR_CONTROL_URL=http://127.0.0.1:8081

# Operator-only configuration root. Keep this separate from /etc/tethys-sentinel,
# which belongs to the sentinel-control service boundary.
SENTINEL_OPERATOR_ADMIN_TOKEN_FILE=/etc/tethys-sentinel-operator/operator-admin.token
SENTINEL_OPERATOR_TLS_CERT=/etc/tethys-sentinel-operator/operator-server.crt
SENTINEL_OPERATOR_TLS_KEY=/etc/tethys-sentinel-operator/operator-server.key
SENTINEL_OPERATOR_CLIENT_CA=/etc/tethys-sentinel-operator/operator-client-ca.crt
